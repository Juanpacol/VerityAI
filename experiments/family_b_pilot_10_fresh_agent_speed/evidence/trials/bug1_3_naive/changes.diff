+    def test_ties_drop_oldest_first(self, pipeline):
+        """No task is given, so rank stage is skipped and every item ties on
+        the default rank_score of 0.0. The docstring promises "oldest goes
+        before the newest" -- the lowest original_index items must be the
+        ones dropped, leaving the newest behind."""
+        items = [item(f"filler {n} " * 5, index=n) for n in range(4)]
