+    def test_dropped_critical_is_populated_when_budget_not_met(self, pipeline):
+        """`dropped_critical` must name the critical items that busted the
+        budget, not stay empty -- an empty list here is indistinguishable
+        from "nothing was protected", which defeats the field's purpose."""
+        items = [item(f"DECISION: choice number {n} " * 20, index=n) for n in range(5)]
+
+        result = pipeline.run(items, budget=10)
+
+        assert result.budget_met is False
+        assert set(result.dropped_critical) == {i.id for i in items}
+
+    def test_dropped_critical_is_empty_when_budget_is_met(self, pipeline):
+        items = [item("DECISION: use postgres not redis", index=0)]
+
+        result = pipeline.run(items, budget=1000)
+
+        assert result.budget_met is True
+        assert result.dropped_critical == []
+
