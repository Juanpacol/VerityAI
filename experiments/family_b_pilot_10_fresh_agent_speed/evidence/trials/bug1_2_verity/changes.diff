+    def test_ties_break_oldest_dropped_first(self, pipeline):
+        """Per the module docstring: within a tie on rank_score, the oldest
+        item (lowest original_index) is the one that goes, not the newest."""
+        items = [
+            ContextItem(
+                kind=ItemKind.AGENT_MESSAGE,
+                content=f"filler content {n}",
+                original_index=n,
+                token_count=10,
+                relevance=Relevance.RELEVANT,
+            )
+            for n in range(4)
+        ]
+
+        survivors = pipeline._enforce_budget(items, budget=30)
+
+        assert [i.original_index for i in survivors] == [1, 2, 3]
