+    def test_ties_break_oldest_dropped_first(self, pipeline):
+        """Same relevance bucket, same (absent) rank score: the docstring on
+        `_enforce_budget` says ties break oldest-first -- the lowest
+        `original_index` should be dropped before a higher one. No task is
+        given so the rank stage is skipped and every item ties at a
+        rank_score of 0.0, isolating the index tiebreak."""
+        items = [
+            item("substantive filler discussion one here", index=0),
+            item("substantive filler discussion two here", index=1),
+        ]
+
+        result = pipeline.run(items, budget=6)
+
+        remaining_indexes = {i.original_index for i in result.items}
+        assert remaining_indexes == {1}
