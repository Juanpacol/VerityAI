--- a/tests/unit/test_prune.py
+++ b/tests/unit/test_prune.py
@@ -47,6 +47,26 @@ class TestCriticalItemsSurvive:
         assert result.budget_met is False
         assert result.tokens_after > 10
 
+    def test_dropped_critical_is_populated_when_budget_not_met(self, pipeline):
+        """Regression: `dropped_critical` was unconditionally reset to `[]`
+        right before being returned, so it never reported anything even when
+        `budget_met` was False. It must list the critical items the budget
+        could not fit."""
+        items = [item(f"DECISION: choice number {n} " * 20, index=n) for n in range(5)]
+
+        result = pipeline.run(items, budget=10)
+
+        assert result.budget_met is False
+        assert set(result.dropped_critical) == {i.id for i in result.items}
+
+    def test_dropped_critical_is_empty_when_budget_met(self, pipeline):
+        items = [item("DECISION: small", index=0)]
+
+        result = pipeline.run(items, budget=1000)
+
+        assert result.budget_met is True
+        assert result.dropped_critical == []
+
     def test_user_messages_are_protected(self, pipeline):
