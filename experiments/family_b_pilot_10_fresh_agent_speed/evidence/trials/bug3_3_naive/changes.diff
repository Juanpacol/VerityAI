diff --git a/tests/unit/test_consistency_check.py b/tests/unit/test_consistency_check.py
index a2abbae..d5e6aff 100644
--- a/tests/unit/test_consistency_check.py
+++ b/tests/unit/test_consistency_check.py
@@ -519,6 +519,23 @@ class TestDecisionResurfacing:
 
         assert check_decision_resurfacing("anything at all", store) == []
 
+    def test_superseded_decision_is_flagged_not_only_rejected(self, store):
+        """Regression: `supersede()` never rewrites the old record's `status`
+        field -- it stays ACTIVE in the log. The old decision must still be
+        reclassified as SUPERSEDED (via `MemoryStore.decisions()` following
+        the `supersedes` chain) so a resembling proposal is flagged here too,
+        not only ones explicitly appended with `status=REJECTED`."""
+        original = store.append(Decision(statement="use a global mutable cache for session state"))
+        store.supersede(original.id, Decision(statement="use per-request session objects"))
+
+        checks = check_decision_resurfacing(
+            "I'll add a global mutable cache for session state to speed this up.",
+            store,
+        )
+
+        assert checks
+        assert checks[0].status is CheckStatus.CONTRADICTED
+
     def test_the_rationale_is_surfaced_when_present(self, store_with_rejected):
         checks = check_decision_resurfacing(
             "global mutable cache for session state", store_with_rejected
diff --git a/tests/unit/test_memory.py b/tests/unit/test_memory.py
index b3c5ea8..d2aaa5e 100644
--- a/tests/unit/test_memory.py
+++ b/tests/unit/test_memory.py
@@ -77,6 +77,22 @@ class TestAppendOnly:
         stored = [d for d in store.read(Decision) if d.id == replacement.id][0]
         assert stored.supersedes == original.id
 
+    def test_superseded_decision_is_reclassified_on_read(self, store):
+        """The old record's own `status` stays ACTIVE in the log (append-only);
+        `decisions()` must follow the `supersedes` chain to exclude it from the
+        active set, per its own docstring."""
+        original = store.append(Decision(statement="use redis"))
+        replacement = store.supersede(original.id, Decision(statement="use postgres"))
+
+        active = store.decisions()
+        assert [d.statement for d in active] == ["use postgres"]
+
+        everyone = store.decisions(include_inactive=True)
+        old = [d for d in everyone if d.id == original.id][0]
+        assert old.status is DecisionStatus.SUPERSEDED
+        new = [d for d in everyone if d.id == replacement.id][0]
+        assert new.status is DecisionStatus.ACTIVE
+
 
