diff --git a/src/verityai/memory/store.py b/src/verityai/memory/store.py
index ed2f6a5..f83a7a4 100644
--- a/src/verityai/memory/store.py
+++ b/src/verityai/memory/store.py
@@ -165,11 +165,25 @@ class MemoryStore:
         Defaults to active only, because that is what belongs in a context.
         The superseded and rejected ones are what the Consistency Engine will
         need in Phase 3 — hence the flag rather than a separate file.
+
+        `supersede()` appends the replacement without rewriting the old
+        record's `status` field in place (append-only), so a decision's
+        recorded status can lag its real one. This is where that gets
+        corrected: any decision that is the target of another decision's
+        `supersedes` is reclassified SUPERSEDED here, on read, regardless of
+        what status its own record carries.
         """
         all_decisions = self.read(Decision)
+        superseded_ids = {d.supersedes for d in all_decisions if d.supersedes is not None}
+        effective = [
+            d.model_copy(update={"status": DecisionStatus.SUPERSEDED})
+            if d.id in superseded_ids and d.status is DecisionStatus.ACTIVE
+            else d
+            for d in all_decisions
+        ]
         if include_inactive:
-            return all_decisions
-        return [d for d in all_decisions if d.status is DecisionStatus.ACTIVE]
+            return effective
+        return [d for d in effective if d.status is DecisionStatus.ACTIVE]
 
     def constraints(self) -> list[Constraint]:
         return self.read(Constraint)
