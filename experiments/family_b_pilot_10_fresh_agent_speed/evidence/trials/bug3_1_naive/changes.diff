         stored = [d for d in store.read(Decision) if d.id == replacement.id][0]
         assert stored.supersedes == original.id
 
+    def test_a_superseded_decision_is_reclassified_on_read(self, store):
+        """The original's on-disk status field stays ACTIVE (append-only, no
+        rewrite) -- decisions() must follow the `supersedes` chain to see
+        that it is no longer current, matching the store.supersede() docstring.
+        """
+        original = store.append(Decision(statement="use redis"))
+        store.supersede(original.id, Decision(statement="use postgres"))
+
+        active = store.decisions()
+        assert len(active) == 1
+        assert active[0].statement == "use postgres"
+
+        everything = store.decisions(include_inactive=True)
+        original_after = [d for d in everything if d.id == original.id][0]
+        assert original_after.status is DecisionStatus.SUPERSEDED
+
 
