diff --git a/tests/unit/test_prune.py b/tests/unit/test_prune.py
index da493e3..c28cd10 100644
--- a/tests/unit/test_prune.py
+++ b/tests/unit/test_prune.py
@@ -242,3 +242,42 @@ class TestBudgetDropOrder:
         kept = result.items[0]
         assert kept.relevance is Relevance.CRITICAL
         assert "decision:" in kept.relevance_reason
+
+    def test_ties_break_oldest_first(self, pipeline):
+        # Same relevance bucket, same rank_score: the docstring promises
+        # ties break on original index, oldest dropped first.
+        old = item("filler " * 20, index=0).model_copy(
+            update={"relevance": Relevance.RELEVANT, "metadata": {"rank_score": 0.5}}
+        )
+        new = item("filler " * 20, index=1).model_copy(
+            update={"relevance": Relevance.RELEVANT, "metadata": {"rank_score": 0.5}}
+        )
+
+        survivors = pipeline._enforce_budget(
+            [pipeline.measure(old, 0), pipeline.measure(new, 1)], budget=20
+        )
+
+        surviving_indices = [i.original_index for i in survivors]
+        assert surviving_indices == [1]
+
+
+class TestDroppedCritical:
+    def test_dropped_critical_populated_when_budget_not_met(self, pipeline):
+        items = [item(f"DECISION: choice number {n} " * 20, index=n) for n in range(5)]
+
+        result = pipeline.run(items, budget=10)
+
+        assert result.budget_met is False
+        assert result.dropped_critical
+        assert set(result.dropped_critical) == {i.id for i in result.items if i.is_protected}
+
+    def test_dropped_critical_empty_when_budget_met(self, pipeline):
+        items = [
+            item("DECISION: use postgres not redis", index=0),
+            item("some ordinary discussion " * 5, index=1),
+        ]
+
+        result = pipeline.run(items, task="database", budget=1000)
+
+        assert result.budget_met is True
+        assert result.dropped_critical == []
