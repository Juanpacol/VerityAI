         assert stored.supersedes == original.id
 
+    def test_superseded_decision_is_reclassified_on_read(self, store):
+        original = store.append(Decision(statement="use redis"))
+        store.supersede(original.id, Decision(statement="use postgres"))
+
+        active = store.decisions()
+        assert [d.statement for d in active] == ["use postgres"]
+
+        everything = store.decisions(include_inactive=True)
+        stored_original = [d for d in everything if d.id == original.id][0]
+        assert stored_original.status is DecisionStatus.SUPERSEDED
+
 
